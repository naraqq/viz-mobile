            <ActionContent
               title = "Setup Flutter and Pods"
               scriptText = "set -e
# Install Flutter via Homebrew if not found
if ! command -v flutter &gt; /dev/null 2&gt;&amp;1; then
  HOMEBREW_NO_AUTO_UPDATE=1 brew install --cask flutter
fi
FLUTTER_BIN=&quot;$(command -v flutter 2&gt;/dev/null || echo /opt/homebrew/bin/flutter)&quot;
# Flutter pub get from project root
cd &quot;$SRCROOT/..&quot;
&quot;$FLUTTER_BIN&quot; pub get
# Pod install
cd &quot;$SRCROOT&quot;
LANG=en_US.UTF-8 pod install --repo-update
">
